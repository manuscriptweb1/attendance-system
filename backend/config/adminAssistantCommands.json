{
  "botInfo": {
    "name": "MTM Admin Assistant",
    "developer": "Mohamed Mushraf",
    "description": "I can help admins check today's attendance, late and absent details, monthly late/absent patterns, reports, payroll, payslips, holidays, and open admin pages."
  },
  "fallback": {
    "unknown": "I could not find an exact match for that. Please choose one of the options below, or type \"help\" to see everything I can do.",
    "withSuggestions": "Here are the closest options for your request. Choose one below:",
    "developerResponse": "I was developed by Mohamed Mushraf."
  },
  "conversation": {
    "greetings": {
      "patterns": ["hi", "hello", "hey", "good morning", "good afternoon", "good evening", "namaste", "namaskar", "salam", "salaam", "assalamualaikum", "assalamu alaikum"],
      "response": "Hi! I am your MTM Admin Assistant. How can I help you today?"
    },
    "wellbeing": {
      "patterns": ["how are you", "how are you doing", "how r u", "how is it going", "are you fine", "kaise ho", "kya haal hai"],
      "response": "I am doing well and ready to help you with attendance, payroll, reports, payslips, and admin tasks."
    },
    "thanks": {
      "patterns": ["thanks", "thank you", "thank you bot", "thx", "shukriya", "dhanyavad", "dhanyawad"],
      "response": "You're welcome! Let me know what you would like to check next."
    },
    "acknowledgement": {
      "patterns": ["ok", "okay", "fine", "good", "done", "theek hai", "thik hai", "accha", "acha"],
      "response": "Sure. What would you like to check next?"
    },
    "bye": {
      "patterns": ["bye", "goodbye", "see you", "alvida"],
      "response": "Goodbye! Have a good day."
    },
    "identity": {
      "patterns": ["who are you", "what are you", "your name"],
      "response": "I am your MTM Admin Assistant. I can show today's attendance, late and absent details, monthly late/absent patterns, reports, payroll and payslips, and open any admin page for you."
    }
  },
  "actions": [
    {
      "id": "navigation",
      "intent": "NAVIGATE",
      "title": "Open Admin Pages",
      "description": "Open admin pages directly.",
      "permission": "page:view",
      "keywords": ["open", "go to", "navigate", "show page"],
      "aliases": ["page", "admin page", "menu"],
      "commands": [
        "open dashboard",
        "open employees",
        "open departments",
        "open attendance",
        "open manual attendance",
        "open permissions",
        "open absent reasons",
        "open holidays",
        "open payroll",
        "open expenses",
        "open reports",
        "open settings",
        "open database monitor",
        "open activity logs",
        "open security logs",
        "open trusted devices",
        "open otp settings",
        "open admin management",
        "open manage"
      ],
      "quickAction": true
    },
    {
