{
  "botInfo": {
    "name": "MTM Admin Assistant",
    "developer": "Mohamed Mushraf",
    "description": "I can help admins navigate pages, search employees, manage attendance, calculate payroll, download payslips, and manage holidays."
  },
  "fallback": {
    "unknown": "I do not know that. Please ask my developer.",
    "developerResponse": "I was developed by Mohamed Mushraf."
  },
  "conversation": {
    "greetings": {
      "patterns": ["hi", "hello", "hey", "good morning", "good afternoon", "good evening"],
      "response": "Hi! I am your MTM Admin Assistant. How can I help you today?"
    },
    "wellbeing": {
      "patterns": ["how are you", "how are you doing", "how r u", "how is it going", "are you fine"],
      "response": "I am doing well and ready to help you with attendance, payroll, reports, payslips, and admin tasks."
    },
    "thanks": {
      "patterns": ["thanks", "thank you", "thank you bot"],
      "response": "You're welcome!"
    },
    "acknowledgement": {
      "patterns": ["ok", "okay", "fine", "good", "done"],
      "response": "Okay."
    },
    "bye": {
      "patterns": ["bye", "goodbye", "see you"],
      "response": "Goodbye! Have a good day."
    },
    "identity": {
      "patterns": ["who are you", "what are you", "your name"],
      "response": "I am your MTM Admin Assistant. I can help you navigate admin pages, search employees, manage attendance, generate reports, calculate payroll, and download payslips."
    }
  },
  "actions": [
    {
      "id": "navigation",
      "intent": "NAVIGATE",
      "title": "Open Admin Pages",
      "description": "Open admin pages directly.",
      "permission": "page:view",
      "keywords": ["open", "go to", "navigate", "show page"],
      "aliases": ["page", "admin page", "menu"],
      "commands": [
        "open dashboard",
        "open employees",
        "open departments",
        "open attendance",
        "open manual attendance",
        "open permissions",
        "open absent reasons",
        "open holidays",
        "open payroll",
        "open expenses",
        "open reports",
        "open settings",
        "open database monitor",
        "open activity logs",
        "open security logs",
        "open trusted devices",
        "open otp settings",
        "open admin management",
        "open manage"
      ],
      "quickAction": true
    },
    {
      "id": "employee_search",
      "intent": "EMPLOYEE_SEARCH",
      "title": "Employee Search",
      "description": "Search employee details by name or employee ID.",
      "permission": "employees:view",
      "keywords": ["employee", "search employee", "find employee", "employee details"],
      "aliases": ["staff search", "find staff"],
      "commands": [
        "find employee Mushraf",
        "search employee MTM-01",
        "show employee Bilal"
      ],
      "quickAction": true
    },
    {
      "id": "today_attendance",
      "intent": "TODAY_ATTENDANCE_SUMMARY",
      "title": "Today Attendance Summary",
      "description": "Show today's attendance summary, absent list, or late list.",
      "permission": "attendance:view",
      "keywords": ["today attendance", "attendance summary", "absent today", "late today"],
      "aliases": ["today status", "today report"],
      "commands": [
        "today attendance",
        "today attendance summary",
        "who is absent today",
        "who is late today"
      ],
      "quickAction": true
    },
    {
      "id": "mark_attendance",
      "intent": "MARK_ATTENDANCE",
      "title": "Mark Attendance",
      "description": "Mark check-in and check-out using existing Manual Attendance logic.",
      "permission": "manual_attendance:create",
      "keywords": ["check in", "check-in", "check out", "checkout", "mark attendance"],
      "aliases": ["put attendance"],
      "commands": [
        "check-in MTM-01",
        "check-in Mushraf",
        "check out MTM-01",
        "check out all employees"
      ],
      "quickAction": true
    },
    {
      "id": "mark_absent",
      "intent": "MARK_ABSENT",
      "title": "Mark Absent",
      "description": "Mark an employee absent for today with reason.",
      "permission": "manual_attendance:create",
      "keywords": ["absent", "mark absent", "employee absent"],
      "aliases": ["put absent"],
      "commands": [
        "mark absent for MTM-01",
        "mark Mohamed Mushraf absent today"
      ],
      "quickAction": true
    },
    {
      "id": "payroll",
      "intent": "CALCULATE_PAYROLL",
      "title": "Payroll",
      "description": "Calculate payroll for selected month and year.",
      "permission": "payroll:calculate",
      "keywords": ["payroll", "salary", "calculate payroll"],
      "aliases": ["salary calculation"],
      "commands": [
        "calculate this month payroll",
        "calculate payroll for July 2026"
      ],
      "quickAction": true
    },
    {
      "id": "payslip",
      "intent": "DOWNLOAD_PAYSLIP",
      "title": "Payslips & Payslip Emails",
      "description": "Download individual or all employee payslips, or send payslip PDF emails via MailerSend.",
      "permission": "payroll:export",
      "keywords": ["payslip", "pay slip", "salary slip", "download payslip", "send payslip", "email payslip", "email payslips"],
      "aliases": ["download salary slip", "email salary slip"],
      "commands": [
        "payslip for MTM-01",
        "send payslip to MTM-01",
        "download July 2026 payslip for Bilal",
        "email payslips for August 2026",
        "download all payslips for July 2026",
        "send all payslips this month"
      ],
      "quickAction": true
    },
    {
      "id": "holiday",
      "intent": "HOLIDAY_ACTION",
      "title": "Holidays",
      "description": "Create or delete holidays.",
      "permission": "holidays:create/delete",
      "keywords": ["holiday", "create holiday", "add holiday", "delete holiday"],
      "aliases": ["remove holiday"],
      "commands": [
        "create holiday tomorrow",
        "add holiday Independence Day on 15 August 2026",
        "delete tomorrow holiday"
      ],
      "quickAction": true
    },
    {
      "id": "report_summary",
      "intent": "REPORT_SUMMARY",
      "title": "Report Summary",
      "description": "Generate and show monthly attendance report summary in bot chat.",
      "permission": "reports:view",
      "keywords": ["report", "reports", "attendance report", "monthly report", "show report", "generate report"],
      "aliases": ["report summary", "employee report"],
      "commands": [
        "show report",
        "show this month report",
        "show July 2026 report",
        "show report for MTM-01",
        "show report for Mohamed Mushraf",
        "generate report for Bilal July 2026"
      ],
      "quickAction": true
    }
  ]
}
